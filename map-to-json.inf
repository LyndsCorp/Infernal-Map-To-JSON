#!/usr/bin/infernal

# =====================================================================
#         Convierte un archivo .map de Infernal a JSON
# =====================================================================
#
#  Uso:
#      infernal j.inf <entrada.map>                 -> JSON a stdout
#      infernal j.inf <entrada.map> <salida.json>   -> JSON a archivo
#
#  Nota: los .list de Infernal ya son JSON válido (list ≡ array de JS),
#  así que no hace falta convertirlos. Solo se procesan .map aquí.
#
#  Nota: fromfile()/test -e resuelven rutas relativas contra el
#  directorio del script, no contra CWD. Este script hace la ruta
#  absoluta contra CWD antes de usarla.
#
#  Licencia: MIT
# =====================================================================

flags(0,
    --oneline {
        oneline = true
    }
)

flags(1,
    empty  = string ruta_entrada
)

flags(2,
    empty = string ruta_salida
)

if not ruta_salida then
    string ruta_salida = ""
fi

# Si oneline es true, el JSON se escribe todo en una sola línea (compacto).
# Si es false, se escribe con indentación de 2 espacios.
if not oneline then
    bool oneline = false
fi

if not ruta_entrada then
    error("Uso: infernal j.inf <entrada.map> [salida.json]")
fi

# --- Resolver la ruta de entrada contra CWD (no contra el script) ---
if not starts($ruta_entrada, "/") then
    local string directorio_actual = pwd
    ruta_entrada = $directorio_actual + "/" + $ruta_entrada
fi

# --- Comprobar existencia con `test -e` (asignado a bool) ---
local bool archivo_existe = test -e $ruta_entrada
if not archivo_existe then
    error("No existe el archivo: " + $ruta_entrada)
fi

# --- Escapa una cadena para incrustarla en un string JSON ---
function json_escape(string cadena)
    local string resultado = replace($cadena, "\\", "\\\\")
    resultado = replace($resultado, "\"", "\\\"")
    resultado = replace($resultado, "\n", "\\n")
    resultado = replace($resultado, "\r", "\\r")
    resultado = replace($resultado, "\t", "\\t")
    return "\"" + $resultado + "\""
fi

# --- Serializa recursivamente un valor de Infernal a JSON.
#     $prefijo es la indentación actual ("" al inicio).
#     Si $compacto es true, se ignora la indentación y todo va en una línea.
#
#     IMPORTANTE: las variables temporales son `local`, porque en Infernal
#     (igual que en bash) una declaración tipada sin `local` crea una
#     variable global del script. En una función recursiva, eso hace que
#     cada llamada pise las variables de su llamador. ---
function to_json(valor, string prefijo, bool compacto)
    local string tipo = vartype($valor)

    if $tipo == "null" then
        return "null"
    fi

    if $tipo == "bool" then
        if $valor then
            return "true"
        fi
        return "false"
    fi

    if $tipo == "int" then
        return "" + $valor
    fi

    if $tipo == "float" then
        return "" + $valor
    fi

    if $tipo == "string" then
        return json_escape($valor)
    fi

    if $tipo == "list" then
        local string resultado = "["
        local bool es_primero = true
        for elemento in $valor then
            if not es_primero then
                resultado = $resultado + ","
            fi
            es_primero = false
            if $compacto then
                resultado = $resultado + to_json($elemento, "", true)
            else
                resultado = $resultado + "\n" + $prefijo + "  " + to_json($elemento, $prefijo + "  ", false)
            fi
        fi
        if $es_primero then
            return "[]"
        fi
        if $compacto then
            return $resultado + "]"
        fi
        return $resultado + "\n" + $prefijo + "]"
    fi

    if $tipo == "map" then
        local string resultado = "{"
        local bool es_primero = true
        for clave in $valor then
            if not es_primero then
                resultado = $resultado + ","
            fi
            es_primero = false
            if $compacto then
                resultado = $resultado + json_escape($clave) + ":" + to_json($valor[$clave], "", true)
            else
                resultado = $resultado + "\n" + $prefijo + "  " + json_escape($clave) + ": " + to_json($valor[$clave], $prefijo + "  ", false)
            fi
        fi
        if $es_primero then
            return "{}"
        fi
        if $compacto then
            return $resultado + "}"
        fi
        return $resultado + "\n" + $prefijo + "}"
    fi

    return "null"
fi

# --- Flujo principal ---

map datos = []
datos = fromfile($ruta_entrada)

local string cadena_json = to_json($datos, "", $oneline)

if $ruta_salida == "" then
    print($cadena_json)
else
    if has($ruta_salida, "'") then
        error("La ruta de salida no puede contener comillas simples: " + $ruta_salida)
    fi
    local string comando = "cat > '" + $ruta_salida + "' << 'INFERNAL_JSON_EOF'\n" + $cadena_json + "\nINFERNAL_JSON_EOF\n"
    local int codigo_salida = exited($comando)
    if $codigo_salida != 0 then
        error("No se pudo escribir el archivo: " + $ruta_salida)
    fi
    print("JSON escrito en: " + $ruta_salida)
fi
